AI_MODE=mock
STORAGE_MODE=file
EVENT_MODE=http
AUTH_MODE=local
DEMO_AUTH=true
# For Okta mode, set the custom authorization server URL, SPA client ID, and API audience.
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_AUDIENCE=
OKTA_AGENT_GROUP=OMS-Agents
OKTA_SUPERVISOR_GROUP=OMS-Supervisors
JWT_SECRET=local-training-jwt-secret
INTERNAL_SECRET=local-training-internal-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Docker Compose supplies service-specific DATABASE_URL values.
# For host-side Prisma commands, set DATABASE_URL including ?schema=resolution or ?schema=investigation.
