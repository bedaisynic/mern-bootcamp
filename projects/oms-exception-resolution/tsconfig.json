{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["apps", "services", "packages", "tests", "playwright.config.ts"],
  "exclude": ["**/generated", "**/dist"]
}
