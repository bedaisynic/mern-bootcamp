                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"showtimeId\": 3,\n  \"seats\": [\n    \"E1\",\n    \"E2\"\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Saves the hold id for the release request below."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  pm.collectionVariables.set(\"holdId\", pm.response.json().holdId);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Hold a taken seat (409, internal)",
              "request": {
                "method": "POST",
                "auth": {
                  "type": "noauth"
                },
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "x-user-id",
                    "value": "1",
                    "description": "Set by the gateway normally. Calling a service directly, you set it yourself."
                  }
                ],
                "url": {
                  "raw": "{{seatsUrl}}/internal/seats/holds",
                  "host": [
                    "{{seatsUrl}}"
                  ],
                  "path": [
                    "internal",
                    "seats",
                    "holds"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"showtimeId\": 1,\n  \"seats\": [\n    \"C4\"\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Release that hold (internal)",
              "request": {
                "method": "DELETE",
                "auth": {
                  "type": "noauth"
                },
                "header": [
                  {
                    "key": "x-user-id",
                    "value": "1",
                    "description": "Set by the gateway normally. Calling a service directly, you set it yourself."
                  }
                ],
                "url": {
                  "raw": "{{seatsUrl}}/internal/seats/holds/{{holdId}}",
                  "host": [
                    "{{seatsUrl}}"
                  ],
                  "path": [
                    "internal",
                    "seats",
                    "holds",
                    "{{holdId}}"
                  ]
