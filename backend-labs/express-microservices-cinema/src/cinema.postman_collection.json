{
  "info": {
    "name": "Cinema Booking — Microservices (Day 17 lab)",
    "description": "Every request goes through the API gateway on {{baseUrl}} (http://localhost:3000), except the last folder, which calls every endpoint of every service directly on its own port.\n\n1. Run `npm run dev` so all 6 processes are up.\n2. Send **Auth → Log in as alice** first. It saves the token into the `token` variable, and every private request uses it automatically.\n3. **Bookings → Book seats** saves the new booking's id into `bookingId`.\n\nUntil you finish the exercises, the bookings requests answer 500 \"not implemented\" — that's expected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "moviesUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "seatsUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "paymentsUrl",
      "value": "http://localhost:3003"
    },
    {
      "key": "notificationsUrl",
      "value": "http://localhost:3004"
    },
    {
      "key": "bookingsUrl",
      "value": "http://localhost:3005"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": "1"
    },
    {
      "key": "holdId",
      "value": "1"
    },
    {
      "key": "paymentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Log in as alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"alice\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Logging in takes just a name: alice, bob, or carol. Saves the token for every private request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"bob\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Switch users: bob can't see or cancel alice's bookings."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as unknown user (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"mallory\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
