    {
      "name": "Gateway security",
      "item": [
        {
          "name": "Private route without a token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Invalid token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not-a-real-token",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Forged x-user-id without a token (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "A client can't pretend to be user 1 by sending the header itself."
          }
        },
        {
          "name": "Forged x-user-id with a token (ignored)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "2"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ]
            },
            "description": "Logged in as alice but claiming to be user 2: the gateway ignores the header and uses the token, so you still get alice's data."
          }
        },
        {
          "name": "Internal route through the gateway (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/internal/seats/holds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "internal",
                "seats",
                "holds"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showtimeId\": 1,\n  \"seats\": [\n    \"A1\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The gateway has no route for /internal, so it's unreachable from outside."
          }
        },
        {
          "name": "Custom x-request-id (check the logs)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "my-trace-123"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/showtimes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "showtimes"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Logs show the first 8 characters of each request id. Search the `npm run dev` output for `my-trace` to see this request in the movies service's log."
          }
        }
      ]
    },
    {
      "name": "Direct to services (skipping the gateway)",
      "description": "Every endpoint of every service, called on the service's own port the way another service would call it.\nThere's no gateway in between, so there's no token check: private endpoints take an `x-user-id` header you set yourself (here always 1, alice).\n\n`/internal/...` endpoints only exist here. The gateway has no route for them.",
