PORT=4000

# Where the lecture frontend (the curriculum Vite app) runs.
FRONTEND_ORIGIN=http://localhost:47821
FRONTEND_URL=http://localhost:47821/week4/day16-auth-security/lecture

# How long an access token lives. Set it to 30s during the lecture to watch the page refresh it.
ACCESS_TOKEN_TTL=15m

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Add GOOGLE_REDIRECT_URI below as an "Authorized redirect URI" on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
