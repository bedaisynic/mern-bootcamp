{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PushDeployBundle",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::monolithic-shop-deploy/*"
    },
    {
      "Sid": "UpdateLambdaCode",
      "Effect": "Allow",
      "Action": ["lambda:UpdateFunctionCode", "lambda:GetFunction", "lambda:PublishVersion"],
      "Resource": "arn:aws:lambda:*:*:function:monolithic-shop-*"
    }
  ]
}
