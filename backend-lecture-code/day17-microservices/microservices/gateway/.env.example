# All optional: the defaults below are what's used when a variable is unset.
PORT=8080
JWT_SECRET=dev-secret-change-me

# Comma-separate several URLs to round-robin between instances, e.g.
# CATALOG_URLS=http://localhost:4102,http://localhost:4112
USERS_URLS=http://localhost:4101
CATALOG_URLS=http://localhost:4102
INVENTORY_URLS=http://localhost:4103
CART_URLS=http://localhost:4104
ORDERS_URLS=http://localhost:4105
PAYMENTS_URLS=http://localhost:4106
NOTIFICATIONS_URLS=http://localhost:4107
RECOMMENDATIONS_URLS=http://localhost:4108
